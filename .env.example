# ============================================================
# MeetingMind 环境变量样例
# 复制本文件为 .env 后按需填写；不创建 .env 即进入「本地模式」，全功能可用。
# ============================================================

# 云开发环境 ID（CloudBase 环境 → 环境 ID，形如 xxx-1a2b3c4d）
# 留空 = 不启用云端
VITE_CLOUDBASE_ENV=

# 云开发地域（默认 ap-shanghai）
VITE_CLOUDBASE_REGION=ap-shanghai

# 显式关闭云端（用于纯本地演示 / 敏感会议）：true / false
VITE_ENABLE_CLOUD=false

# ============================================================
# 腾讯云实时语音识别（可选）
# 浏览器原生 Web Speech 在部分网络下不可用，可在此注入腾讯云凭证，
# 改用云端实时转写（实时字幕更稳）。也可不在 .env 中填写，改在「设置 →
# 腾讯云实时语音识别」里手动填入（凭证仅存本机浏览器）。
# 获取地址：腾讯云控制台 → 访问管理 → API 密钥（SecretId / SecretKey），
# AppId 在「账号信息」页。
# ============================================================
VITE_TENCENT_ASR_SECRET_ID=
VITE_TENCENT_ASR_SECRET_KEY=
VITE_TENCENT_ASR_APP_ID=
